# env
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/

# data (git-ignored per BUILD_GUIDE 3; provenance lives in docs/DATASETS.md)
data/raw/
data/ledger/*
!data/ledger/.gitkeep
data/rendered/*
!data/rendered/.gitkeep
data/annotated/
data/splits/*
!data/splits/.gitkeep

# runs: keep summaries, drop bulky artefacts
runs/*
!runs/.gitkeep
!runs/*/
runs/**/*
!runs/**/summary.md
!runs/**/SUMMARY.md
!runs/*/summary.md
!runs/*/SUMMARY.md

# models
models/
*.faiss
*.index

# caches
.cache/
.hypothesis/
.zvec-grep/

# local agent state
.commandcode/

# downloaded fonts (build_both.py fetches them on demand)
fonts/

# generated PDFs from `build_both.py --out-dir out`
out/

# SQLite sidecars are runtime state, never source
data/engine.db-shm
data/engine.db-wal

# keep the small measured artefacts the docs cite
!runs/meetings/*.json
!runs/v4/*.json
